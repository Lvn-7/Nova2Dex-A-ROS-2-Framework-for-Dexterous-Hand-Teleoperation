<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>brainco_hand_dds_bridge</name>
  <version>0.0.1</version>
  <description>ROS 2 JointState to Unitree DDS bridge for BrainCo Revo2 hand service.</description>
  <maintainer email="lvn@example.com">lvn</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>nova2_glove_driver</exec_depend>
  <exec_depend>manus_revo2_retarget</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
